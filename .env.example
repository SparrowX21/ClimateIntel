# ── Required ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEE_PROJECT_ID=your-gee-project-id

# ── Earth Engine (server deployment only — local dev uses `earthengine authenticate`) ──
# GEE_SERVICE_ACCOUNT=name@project.iam.gserviceaccount.com
# GEE_SERVICE_KEY_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# ── Optional (defaults shown) ────────────────────────
# WATER_MODEL_PATH=water_stress.json
# ECO_MODEL_PATH=ecological_stress.json
# CACHE_TTL=3600
# MAX_CACHE_ENTRIES=500
# FRONTEND_ORIGIN=http://localhost:3000
# PORT=5000
# FLASK_DEBUG=0

# ── Frontend (Vite) ──────────────────────────────────
# VITE_API_URL=http://localhost:5000
